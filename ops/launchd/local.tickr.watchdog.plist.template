<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tickr watchdog: independent of the bot job, running at every hour: launchd starts it at
     load, at the configured weekday time, and again whenever it ends (at most once per
     ThrottleInterval, [runtime] watchdog_relaunch_seconds). It never
     takes the bot's lock and never sends a trading request: it reads positions and open orders
     at calendar-derived times after the flatten time and alerts if anything is left, during
     the session alerts if the bot is not running while the database shows an open trade, and
     at any hour alerts when the bot stopped without a clean stop or the data disk runs low.
     Near the flatten time it may start the bot job once a day (launchctl kickstart, no -k)
     so the bot itself flattens a trade it left open.
     Its record is data_dir/[runtime] watchdog_journal_file and this job's log.
     caffeinate keeps the Mac awake while it runs (see the bot job and docs/operations.md).
     It runs the release its folder argument resolves to at the start (cd -P), so a
     release switch never changes the code under a running job (runtime/release.py).
     Rendered by `python -m tickr.runtime render-launchd`; see docs/operations.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.tickr.watchdog</string>
  <key>WorkingDirectory</key>
  <string>{{RELEASE}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$0"; set +a; cd -P "$1" || exit; /usr/bin/caffeinate -i -s -w $$ &gt;/dev/null 2&gt;&amp;1 &amp; exec "$PWD/$2" -m tickr.runtime --config "$PWD/$3" watchdog</string>
    <string>{{ENV_FILE}}</string>
    <string>{{RELEASE}}</string>
    <string>{{PYTHON}}</string>
    <string>{{CONFIG}}</string>
  </array>
  <key>StartCalendarInterval</key>
  {{WATCHDOG_CALENDAR}}
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>{{WATCHDOG_THROTTLE}}</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/watchdog.log</string>
</dict>
</plist>
