<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Aperture preflight: runs before the session on configured weekdays, alerts on failure.
     Rendered by `python -m aperture.runtime render-launchd`; see docs/operations.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.aperture.preflight</string>
  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>
  <!-- The credentials file is sourced by sh so Aperture code never reads secret values. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$0"; set +a; exec "$1" -m aperture.runtime --config "$2" preflight</string>
    <string>{{ENV_FILE}}</string>
    <string>{{PYTHON}}</string>
    <string>{{CONFIG}}</string>
  </array>
  <key>StartCalendarInterval</key>
  {{PREFLIGHT_CALENDAR}}
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/preflight.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/preflight.log</string>
</dict>
</plist>
