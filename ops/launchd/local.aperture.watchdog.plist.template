<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Aperture watchdog: started on configured weekdays, independent of the bot job. It never
     takes the bot's lock and never sends a trading request: it reads positions and open orders
     at calendar-derived times after the flatten time and alerts if anything is left, and during
     the session alerts if the bot is not running while the database shows an open trade.
     Its record is data_dir/[runtime] watchdog_journal_file and this job's log.
     caffeinate keeps the Mac awake while it runs (see the bot job and docs/operations.md).
     Rendered by `python -m aperture.runtime render-launchd`; see docs/operations.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.aperture.watchdog</string>
  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$0"; set +a; /usr/bin/caffeinate -i -s -w $$ &gt;/dev/null 2&gt;&amp;1 &amp; exec "$1" -m aperture.runtime --config "$2" watchdog</string>
    <string>{{ENV_FILE}}</string>
    <string>{{PYTHON}}</string>
    <string>{{CONFIG}}</string>
  </array>
  <key>StartCalendarInterval</key>
  {{WATCHDOG_CALENDAR}}
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/watchdog.log</string>
</dict>
</plist>
