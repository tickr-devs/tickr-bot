<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tickr bot: started before the open on configured weekdays; preflight runs again first.
     Never relaunched by launchd: KeepAlive is false and a crash raises an alert instead. The
     watchdog may start it once a day near the flatten time to flatten a trade left open.
     launchd stops it with SIGTERM and waits ExitTimeOut seconds for a clean close.
     caffeinate -i -s -w holds a no-sleep assertion for exactly as long as this job's process
     lives (exec keeps the shell's pid); it is a side process, so SIGTERM from launchd still
     reaches the supervisor directly. See docs/operations.md for its limits.
     It runs the release its folder argument resolves to at the start (cd -P), so a
     release switch never changes the code under a running job (runtime/release.py).
     Rendered by `python -m tickr.runtime render-launchd`; see docs/operations.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.tickr.bot</string>
  <key>WorkingDirectory</key>
  <string>{{RELEASE}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$0"; set +a; cd -P "$1" || exit; /usr/bin/caffeinate -i -s -w $$ &gt;/dev/null 2&gt;&amp;1 &amp; exec "$PWD/$2" -m tickr.runtime --config "$PWD/$3" run-bot -- "$PWD/$2" -m tickr.cli --config "$PWD/$3" run</string>
    <string>{{ENV_FILE}}</string>
    <string>{{RELEASE}}</string>
    <string>{{PYTHON}}</string>
    <string>{{CONFIG}}</string>
  </array>
  <key>StartCalendarInterval</key>
  {{BOT_CALENDAR}}
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ExitTimeOut</key>
  <integer>{{BOT_EXIT_TIMEOUT}}</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/bot.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/bot.log</string>
</dict>
</plist>
