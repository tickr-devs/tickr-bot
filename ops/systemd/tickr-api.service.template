# Tickr local API: always on (compose service `api`, restart: unless-stopped). It needs no
# credential: no env file is mounted into it. Docker publishes no port (network_mode: host,
# loopback bind from [api] in bot.toml).
# Rendered by `python -m tickr.runtime render-systemd`; see docs/deploy-server.md.
[Unit]
Description=Tickr local API
RequiresMountsFor={{DATA_HOST}}
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User={{USER}}
EnvironmentFile={{COMPOSE_ENV}}
Environment=TICKR_CONFIG_HOST={{CONFIG_HOST}}
ExecStart=/usr/bin/docker compose -f {{COMPOSE}} up -d api
ExecStop=/usr/bin/docker compose -f {{COMPOSE}} stop api

[Install]
WantedBy=multi-user.target
