# Tickr nightly backtest data job: after the close on configured weekdays, adds the newest
# sessions to the folder the Lab replays (compose service `nightly-fetch`, profile jobs, never
# restarted). Reads market data only; never trades. The env file is the path {{ENV_FILE}} on
# the host, written by tickr-secrets.service; only its path is named here, never a value.
# Rendered by `python -m tickr.runtime render-systemd`; see docs/deploy-server.md.
[Unit]
Description=Tickr nightly backtest data
RequiresMountsFor={{DATA_HOST}}
Requires=docker.service tickr-secrets.service
After=docker.service tickr-secrets.service

[Service]
Type=oneshot
User={{USER}}
EnvironmentFile={{COMPOSE_ENV}}
Environment=TICKR_CONFIG_HOST={{CONFIG_HOST}}
Environment=TICKR_ENV_FILE_HOST={{ENV_FILE}}
ExecStart=/usr/bin/docker compose -f {{COMPOSE}} --profile jobs run --rm nightly-fetch
