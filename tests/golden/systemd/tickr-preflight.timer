# Starts tickr-preflight.service on the configured weekdays ([runtime] preflight_start_local, in
# the zone given to render-systemd). A start missed while the server was down is not caught up.
[Unit]
Description=Tickr preflight schedule

[Timer]
OnCalendar=Mon,Tue,Wed,Thu,Fri *-*-* 03:30:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
