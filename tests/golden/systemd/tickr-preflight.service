# Tickr preflight job: runs before the session on configured weekdays, alerts on failure
# (compose service `preflight`, profile jobs, never restarted). The env file is the path
# /run/tickr/env on the host, written by tickr-secrets.service; it is mounted read-only into the
# container and sourced by the entrypoint. Only its path is named here, never a value.
# Rendered by `python -m tickr.runtime render-systemd`; see docs/deploy-server.md.
[Unit]
Description=Tickr preflight
Requires=docker.service tickr-secrets.service
After=docker.service tickr-secrets.service

[Service]
Type=oneshot
User=tickr
WorkingDirectory=/srv/tickr/repo
EnvironmentFile=/srv/tickr/etc/limits.env
Environment=TICKR_CONFIG_HOST=/srv/tickr/etc/bot.toml
Environment=TICKR_ENV_FILE_HOST=/run/tickr/env
ExecStart=/usr/bin/docker compose -f ops/docker/compose.yaml --profile jobs run --rm preflight
