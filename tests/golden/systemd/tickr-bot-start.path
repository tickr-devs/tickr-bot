# Tickr bot start request watch: starts tickr-bot-start.service when the request file exists.
# The API's Start ([api] start_bot_command) writes it from inside its container (`python -m
# tickr.runtime request-start`, [runtime] server_start_request_file under the data folder,
# mounted from /srv/tickr/data). The service renames the file first, so one request starts the
# bot at most once.
# Rendered by `python -m tickr.runtime render-systemd`; see docs/deploy-server.md.
[Unit]
Description=Tickr bot start request watch
RequiresMountsFor=/srv/tickr/data

[Path]
PathExists=/srv/tickr/data/control/start-request
Unit=tickr-bot-start.service

[Install]
WantedBy=multi-user.target
