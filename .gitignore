__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# SwiftPM build folders and local package state of every Swift package (apps/shared, apps/macos,
# apps/ios), wherever `swift build` or Xcode runs.
.build/
.swiftpm/
# Runtime data, secrets and tokens never enter the repository.
.env
.env.*
/data/
*.sqlite3
*.sqlite3-*
authorization/
# Xcode per-user state (window layout, breakpoints, schemes order).
xcuserdata/
# The `tickr demo` folder (rebuilt by the command, never real data).
/demo/
/demo.lock
# The demo fixture and the folder it is built in: built on each Mac from the committed inputs by
# `tickr demo` (docs/demo.md), never committed (a binary that every rebuild changes).
/demo-fixture/
/demo-build/
/demo-build.lock
# `tickr demo --record` replays into its own folder and deletes it when done.
/demo-record/
/demo-record.lock
# SwiftPM pins Xcode writes for the root workspace; each project and package commits its own.
/Tickr.xcworkspace/xcshareddata/swiftpm/
