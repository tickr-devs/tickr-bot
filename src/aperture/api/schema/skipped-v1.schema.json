{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:skipped-v1",
  "title": "SkippedV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "symbol": {
            "type": "string"
          },
          "strategy": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "admission": {
            "type": "string",
            "enum": [
              "taken",
              "refused",
              "not_evaluated",
              "not_applicable"
            ]
          },
          "refusal_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string"
                },
                "measured": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operator": {
                  "type": "string"
                },
                "threshold": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "rule",
                "measured",
                "operator",
                "threshold",
                "passed",
                "note"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "at",
          "symbol",
          "strategy",
          "admission",
          "refusal_cause",
          "entry_price",
          "stop_price",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "day",
    "signals",
    "api_version"
  ],
  "additionalProperties": false
}
