{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:day-v1",
  "title": "DayV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "entry_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "exit_price": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "opened_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "closed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "exit_reason": {
            "type": "string"
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "planned_loss_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "result_gross_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        },
        "required": [
          "trade_id",
          "symbol",
          "quantity",
          "entry_price",
          "exit_price",
          "opened_at",
          "closed_at",
          "exit_reason",
          "stop_price",
          "planned_loss_usd",
          "result_gross_usd"
        ],
        "additionalProperties": false
      }
    },
    "result_gross_usd": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "bar_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "environment",
    "day",
    "trades",
    "result_gross_usd",
    "bar_symbols",
    "api_version"
  ],
  "additionalProperties": false
}
