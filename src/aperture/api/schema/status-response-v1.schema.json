{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:status-response-v1",
  "title": "StatusResponseV1",
  "type": "object",
  "properties": {
    "served_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "status": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "written_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "bot_state": {
              "type": "string",
              "enum": [
                "starting",
                "running",
                "stopping",
                "stopped"
              ]
            },
            "run_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "environment": {
              "type": "string"
            },
            "trading_gate": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "cause": {
                  "type": "string"
                }
              },
              "required": [
                "open",
                "cause"
              ],
              "additionalProperties": false
            },
            "strategy": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "entry_stop": {
              "type": "boolean"
            },
            "entry_block": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "cause": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cause",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "fences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "since": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "since",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "position": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    "entry_price": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    "opened_at": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    "stop": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "verified",
                            "pending",
                            "missing",
                            "unknown"
                          ]
                        },
                        "price": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "client_order_id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "state",
                        "price",
                        "client_order_id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "symbol",
                    "quantity",
                    "entry_price",
                    "opened_at",
                    "stop"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "trades_today": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "entry_price": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "exit_price": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "opened_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "closed_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "exit_reason": {
                    "type": "string"
                  },
                  "result_gross_usd": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "symbol",
                  "quantity",
                  "entry_price",
                  "exit_price",
                  "opened_at",
                  "closed_at",
                  "exit_reason",
                  "result_gross_usd"
                ],
                "additionalProperties": false
              }
            },
            "result_today_gross_usd": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "freshness": {
              "type": "object",
              "properties": {
                "last_broker_read_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "last_quote_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stream": {
                  "type": "string",
                  "enum": [
                    "fresh",
                    "quiet",
                    "lost",
                    "off"
                  ]
                }
              },
              "required": [
                "last_broker_read_at",
                "last_quote_at",
                "stream"
              ],
              "additionalProperties": false
            },
            "recent_commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command_id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "entry-stop-on",
                      "entry-stop-off",
                      "cancel-own-orders",
                      "flatten",
                      "stop-bot",
                      "emergency"
                    ]
                  },
                  "requested_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "processed_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "done",
                      "refused"
                    ]
                  },
                  "cause": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "command_id",
                  "kind",
                  "requested_at",
                  "processed_at",
                  "outcome",
                  "cause"
                ],
                "additionalProperties": false
              }
            },
            "realized_loss_today_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "open_reservations_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "daily_room_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "entry_price": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "opened_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "stop": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "pending",
                          "missing",
                          "unknown"
                        ]
                      },
                      "price": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "client_order_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "state",
                      "price",
                      "client_order_id"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "symbol",
                  "quantity",
                  "entry_price",
                  "opened_at",
                  "stop"
                ],
                "additionalProperties": false
              }
            },
            "schema_version": {
              "type": "integer",
              "const": 1
            }
          },
          "required": [
            "written_at",
            "bot_state",
            "run_id",
            "environment",
            "trading_gate",
            "strategy",
            "entry_stop",
            "entry_block",
            "fences",
            "position",
            "trades_today",
            "result_today_gross_usd",
            "freshness",
            "recent_commands",
            "realized_loss_today_usd",
            "open_reservations_usd",
            "daily_room_usd",
            "positions",
            "schema_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "age_seconds": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "unavailable_cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "poll_seconds": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "served_at",
    "status",
    "age_seconds",
    "stale",
    "unavailable_cause",
    "summary",
    "poll_seconds",
    "api_version"
  ],
  "additionalProperties": false
}
