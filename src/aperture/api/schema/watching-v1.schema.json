{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:watching-v1",
  "title": "WatchingV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "total": {
      "type": "integer"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "strategy": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "verdict": {
            "type": "string",
            "enum": [
              "IGNORE",
              "WATCH",
              "ENTER",
              "HOLD",
              "EXIT"
            ]
          },
          "decisive_check": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "measured": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operator": {
                    "type": "string"
                  },
                  "threshold": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "rule",
                  "measured",
                  "operator",
                  "threshold",
                  "passed",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "closeness": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closeness_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quote_age_seconds": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "quote_age_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "symbol",
          "at",
          "strategy",
          "verdict",
          "decisive_check",
          "closeness",
          "closeness_cause",
          "quote_age_seconds",
          "quote_age_cause"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "day",
    "total",
    "rows",
    "api_version"
  ],
  "additionalProperties": false
}
