{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:observers-v1",
  "title": "ObserversV1",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "observers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                },
                "symbol": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "IGNORE",
                    "WATCH",
                    "ENTER",
                    "HOLD",
                    "EXIT"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "at",
                "symbol",
                "action",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "result_gross_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "version",
          "decisions",
          "result_gross_usd",
          "result_cause"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "day",
    "observers",
    "api_version"
  ],
  "additionalProperties": false
}
