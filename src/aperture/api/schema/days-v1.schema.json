{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aperture:days-v1",
  "title": "DaysV1",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "trades": {
            "type": "integer"
          },
          "wins": {
            "type": "integer"
          },
          "losses": {
            "type": "integer"
          },
          "result_gross_usd": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "has_bars": {
            "type": "boolean"
          }
        },
        "required": [
          "day",
          "trades",
          "wins",
          "losses",
          "result_gross_usd",
          "has_bars"
        ],
        "additionalProperties": false
      }
    },
    "api_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "environment",
    "days",
    "api_version"
  ],
  "additionalProperties": false
}
