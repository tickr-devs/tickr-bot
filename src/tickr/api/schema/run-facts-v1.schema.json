{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickr:run-facts-v1",
  "title": "RunFactsV1",
  "type": "object",
  "properties": {
    "written_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "run_id": {
      "type": "string"
    },
    "protection_in_force": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "adopted_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "value",
          "adopted_at"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "written_at",
    "run_id",
    "protection_in_force",
    "schema_version"
  ],
  "additionalProperties": false
}
